# =============================================================================
# PiK's Digital Lab - Environment Variables Template
# =============================================================================
# Salin file ini menjadi ".env" dan isi dengan kredensial asli Anda.
# Jika dibiarkan kosong atau file .env tidak ada, aplikasi akan berjalan dalam
# mode SANDBOX (simulasi) secara otomatis.
# =============================================================================

# --- SERVER ---
PORT=3000
SESSION_SECRET=piks_digital_lab_secret_key_ganti_ini_dengan_random_string

# Origin frontend (CORS allowlist di production). Contoh Vercel:
# APP_ORIGIN=https://your-app.vercel.app
APP_ORIGIN=http://localhost:3000

# Base URL publik untuk media yang di-fetch platform (IG/FB/TikTok).
# Wajib di cloud (HTTPS) — jangan biarkan localhost di Vercel/production.
# Publish OAuth menolak media localhost saat NODE_ENV=production / VERCEL=1.
# PUBLIC_BASE_URL=https://your-app.vercel.app
PUBLIC_BASE_URL=http://localhost:3000

# Opsional nanti: Vercel Blob (persist upload cloud). Belum di-wire di kode.
# Setelah set, arahkan /api/media/upload ke Blob dan simpan URL https absolut di post.mediaUrl.
# BLOB_READ_WRITE_TOKEN=

# --- APP LOGIN (bootstrap admin) ---
# Email di-normalize (lowercase). Saat start/login:
# - jika user belum ada → dibuat sebagai admin
# - jika sudah ada → password di-sync dari env di bawah (sumber kebenaran)
# WAJIB restart server setelah mengubah nilai ini (dotenv hanya load saat boot).
ADMIN_EMAIL=admin@localhost
# Prefer bcrypt hash. Generate: node -e "console.log(require('bcryptjs').hashSync('password',10))"
ADMIN_PASSWORD_HASH=
# Plain untuk lokal (akan di-hash). Tidak ada min-length — "123" OK di lokal.
# Hindari plain di production; pakai ADMIN_PASSWORD_HASH.
ADMIN_PASSWORD=changeme
# ADMIN_NAME=Admin

# --- NEON POSTGRES (wajib di Vercel) ---
# Di Neon console → Connect → salin connection string (URI)
# Contoh: postgresql://user:pass@ep-xxx.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Proteksi cron Vercel — WAJIB di production (VERCEL=1 / NODE_ENV=production)
CRON_SECRET=

# Enkripsi secret at-rest: accessToken / refreshToken / pageToken + session browser (jika key set)
# Minimal 16 karakter. Diset → AES-256-GCM (lib/token-crypto.js) pada upsertAccount / sessions/*.
# Di production: kosong = warn jelas (token plain). Lokal: warn sekali.
# Jangan commit nilai asli. Jangan log token.
TOKEN_ENCRYPTION_KEY=

# --- META (FACEBOOK & INSTAGRAM) ---
# Daftarkan di: https://developers.facebook.com/
# Izin diperlukan: pages_manage_posts, instagram_content_publish, pages_read_engagement
META_CLIENT_ID=
META_CLIENT_SECRET=
META_REDIRECT_URI=http://localhost:3000/api/auth/meta/callback

# --- GOOGLE / YOUTUBE ---
# Daftarkan di: https://console.cloud.google.com/
# Aktifkan: YouTube Data API v3
# Izin diperlukan: https://www.googleapis.com/auth/youtube.upload
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/youtube/callback

# --- TIKTOK ---
# Daftarkan di: https://developers.tiktok.com/
# Izin diperlukan: video.upload, video.publish
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:3000/api/auth/tiktok/callback
