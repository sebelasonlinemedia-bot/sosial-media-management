{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "automation/**",
          "lib/**",
          "mcp/**",
          "js/**",
          "schema.sql",
          "index.html",
          "app.js",
          "ai-office-3d.js",
          "styles.css",
          "replica-common.css",
          "chat-replica.css",
          "tasks-replica.css",
          "calendar-replica.css",
          "drive-replica.css",
          "crm-replica.css",
          "library-replica.css",
          "mailbox-replica.css",
          "employees-replica.css",
          "routine-replica.css",
          "knowledge-replica.css",
          "tools-replica.css",
          "db.js",
          "db-postgres.js",
          "server.js"
        ]
      }
    }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "api/index.js" }
  ],
  "crons": [
    {
      "path": "/api/cron/publish",
      "schedule": "0 12 * * *"
    }
  ]
}
